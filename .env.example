# 可提交。凭证字段留空，其余与本机 .env.develop 相同。实际凭证只写在 .env.develop。

# createLlm 未传模型名时，用这个名字取映射表里的配置
DEFAULT_MODEL=ollama

# Ollama 本地（MODEL 带 :tag 即走本地）
OLLAMA_API_KEY=
OLLAMA_MODEL=deepseek-r1:8b
OLLAMA_BASE_URL=http://localhost:11434

# DeepSeek 云端
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Google Gemini（备用）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
